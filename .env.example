# Copy this file to .env.local for local testing (with `vercel dev`),
# and set the same variables in your Vercel project settings for production.
# Never commit your real .env.local — it's already covered by .gitignore.

# From https://resend.com/api-keys after creating a free account
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Once you verify your domain in Resend (Domains tab), change this to
# something like: Pixel Crush <no-reply@pixelcrush.lk>
# Until then, you must use the default Resend sandbox address below.
EMAIL_FROM=Pixel Crush <onboarding@resend.dev>

# Where "New Order" notification emails get sent (can be the same as your
# admin dashboard login email, or a shared studio inbox)
ADMIN_NOTIFY_EMAIL=pixelcrushgraphics@gmail.com
